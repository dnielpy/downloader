{
  "manifest_version": 3,
  "name": "Descargador",
  "description": "Manda las descargas de Chrome al linkgrabber del descargador.",
  "version": "1.0.0",
  "permissions": ["downloads", "storage", "notifications", "contextMenus"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Descargador: clic para activar o desactivar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
