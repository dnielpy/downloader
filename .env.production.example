# Folders on the external hard drive. They must exist and the drive must be mounted before starting the containers.
# Where the downloads are saved (JDownloader sees it as /output)
DOWNLOADS_PATH=/mnt/localtube/downloads
# JDownloader's settings, accounts and download lists
JD_CONFIG_PATH=/mnt/localtube/jdownloader

# The owner of the files JDownloader writes (`id -u` and `id -g` of the server user)
USER_ID=1000
GROUP_ID=1000

# Port on the host: the web at http://<ip of the host>:WEB_PORT
WEB_PORT=3008

# Java memory for JDownloader (G, M or K)
JD_MAX_MEM=768M

TZ=America/Havana
